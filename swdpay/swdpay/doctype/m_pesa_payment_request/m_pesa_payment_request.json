{
 "doctype": "DocType",
 "name": "M-Pesa Payment Request",
 "module": "Swdpay",
 "autoname": "MPPR-.YYYY.-.#####",
 "naming_rule": "Expression (old style)",
 "editable_grid": 1,
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": ["status", "requested_by", "project", "amount", "recipient_section", "recipient_type", "till_number", "paybill_number", "account_reference", "phone_number", "payee_name", "description", "party_section", "party_type", "party", "receiver_public_name", "daraja_section", "originator_conversation_id", "conversation_id", "mpesa_transaction_id", "result_code", "result_desc", "raw_result", "receipt_section", "receipt_pending", "receipt_photo", "etims_url", "etims_invoice_number", "receipt_captured_on", "links_section", "payment_entry", "rejection_reason", "error_message"],
 "fields": [
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Requested\nApproved\nSending\nPaid\nFailed\nRejected\nCancelled", "default": "Requested", "in_list_view": 1, "in_standard_filter": 1, "read_only": 1},
  {"fieldname": "requested_by", "fieldtype": "Link", "label": "Requested By", "options": "User", "read_only": 1, "in_list_view": 1},
  {"fieldname": "project", "fieldtype": "Link", "label": "Project", "options": "Project", "in_standard_filter": 1},
  {"fieldname": "amount", "fieldtype": "Currency", "label": "Amount (KES)", "reqd": 1, "in_list_view": 1},
  {"fieldname": "recipient_section", "fieldtype": "Section Break", "label": "Recipient"},
  {"fieldname": "recipient_type", "fieldtype": "Select", "label": "Recipient Type", "options": "Buy Goods Till\nPaybill\nPhone", "reqd": 1, "in_standard_filter": 1},
  {"fieldname": "till_number", "fieldtype": "Data", "label": "Till Number", "depends_on": "eval:doc.recipient_type=='Buy Goods Till'", "mandatory_depends_on": "eval:doc.recipient_type=='Buy Goods Till'"},
  {"fieldname": "paybill_number", "fieldtype": "Data", "label": "Paybill Number", "depends_on": "eval:doc.recipient_type=='Paybill'", "mandatory_depends_on": "eval:doc.recipient_type=='Paybill'"},
  {"fieldname": "account_reference", "fieldtype": "Data", "label": "Account Reference", "depends_on": "eval:doc.recipient_type=='Paybill'", "mandatory_depends_on": "eval:doc.recipient_type=='Paybill'"},
  {"fieldname": "phone_number", "fieldtype": "Data", "label": "Phone Number", "depends_on": "eval:doc.recipient_type=='Phone'", "mandatory_depends_on": "eval:doc.recipient_type=='Phone'"},
  {"fieldname": "payee_name", "fieldtype": "Data", "label": "Payee Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
  {"fieldname": "party_section", "fieldtype": "Section Break", "label": "Linked Party"},
  {"fieldname": "party_type", "fieldtype": "Link", "label": "Party Type", "options": "DocType", "ignore_user_permissions": 1},
  {"fieldname": "party", "fieldtype": "Dynamic Link", "label": "Party", "options": "party_type"},
  {"fieldname": "receiver_public_name", "fieldtype": "Data", "label": "M-Pesa Registered Name", "read_only": 1},
  {"fieldname": "daraja_section", "fieldtype": "Section Break", "label": "Daraja", "collapsible": 1},
  {"fieldname": "originator_conversation_id", "fieldtype": "Data", "label": "Originator Conversation ID", "read_only": 1, "unique": 1},
  {"fieldname": "conversation_id", "fieldtype": "Data", "label": "Conversation ID", "read_only": 1},
  {"fieldname": "mpesa_transaction_id", "fieldtype": "Data", "label": "M-Pesa Transaction ID", "read_only": 1},
  {"fieldname": "result_code", "fieldtype": "Data", "label": "Result Code", "read_only": 1},
  {"fieldname": "result_desc", "fieldtype": "Small Text", "label": "Result Description", "read_only": 1},
  {"fieldname": "raw_result", "fieldtype": "Code", "label": "Raw Result Payload", "read_only": 1},
  {"fieldname": "receipt_section", "fieldtype": "Section Break", "label": "Receipt / eTIMS"},
  {"fieldname": "receipt_pending", "fieldtype": "Check", "label": "Receipt Pending", "read_only": 1},
  {"fieldname": "receipt_photo", "fieldtype": "Attach", "label": "Receipt Photo"},
  {"fieldname": "etims_url", "fieldtype": "Small Text", "label": "eTIMS URL"},
  {"fieldname": "etims_invoice_number", "fieldtype": "Data", "label": "eTIMS Invoice Number"},
  {"fieldname": "receipt_captured_on", "fieldtype": "Datetime", "label": "Receipt Captured On", "read_only": 1},
  {"fieldname": "links_section", "fieldtype": "Section Break", "label": "Links"},
  {"fieldname": "payment_entry", "fieldtype": "Link", "label": "Payment Entry", "options": "Payment Entry", "read_only": 1},
  {"fieldname": "rejection_reason", "fieldtype": "Small Text", "label": "Rejection Reason", "read_only": 1},
  {"fieldname": "error_message", "fieldtype": "Small Text", "label": "Error Message", "read_only": 1}
 ],
 "permissions": [
  {"role": "M-Pesa Payment Requester", "create": 1, "read": 1, "if_owner": 1},
  {"role": "M-Pesa Payment Approver", "create": 1, "read": 1, "write": 1},
  {"role": "System Manager", "create": 1, "read": 1, "write": 1, "delete": 1}
 ],
 "sort_field": "creation",
 "sort_order": "DESC"
}
